{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mtglab-ui",
      "runtimeExecutable": ".venv/bin/mtglab",
      "runtimeArgs": ["ui", "--no-open", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "mtglab-ui-no-corpus",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MTGLAB_DATA_DIR=$(mktemp -d) .venv/bin/mtglab ui --no-open --port 8766"
      ],
      "port": 8766
    },
    {
      "name": "mtglab-ui-empty-library",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MTGLAB_DECKS_DIR=$(mktemp -d) .venv/bin/mtglab ui --no-open --port 8768"
      ],
      "port": 8768
    }
  ]
}

