{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mtglab-ui",
      "runtimeExecutable": "go/mtglab",
      "runtimeArgs": ["ui", "--no-open", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "mtglab-ui-no-pool",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MTGLAB_DATA_DIR=$(mktemp -d) go/mtglab ui --no-open --port 8766"
      ],
      "port": 8766
    },
    {
      "name": "mtglab-ui-auth",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MTGLAB_DATA_DIR=${TMPDIR:-/tmp}/mtglab-auth-demo MTGLAB_REQUIRE_AUTH=1 MTGLAB_BASE_URL=http://127.0.0.1:8767 go/mtglab ui --no-open --port 8767"
      ],
      "port": 8767
    },
    {
      "name": "mtglab-ui-empty-library",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "MTGLAB_DECKS_DIR=$(mktemp -d) go/mtglab ui --no-open --port 8768"
      ],
      "port": 8768
    },
    {
      "// web-dev": [
        "Vite with HMR, for visual work. `vite.config.ts` proxies /api to",
        "127.0.0.1:8765, so `mtglab-ui` has to be running alongside it — this",
        "entry serves the frontend, that one serves the data.",
        "",
        "The other four entries serve the *committed* bundle out of",
        "`web_dist`, so a change under `web/src` is invisible to",
        "them until `npm --prefix web run build`. That is the right thing for",
        "testing what ships and the wrong thing for iterating on a colour."
      ],
      "name": "web-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "npm --prefix web run dev"],
      "port": 5173
    }
  ]
}

