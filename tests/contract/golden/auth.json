{
  "claim-bad-token": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 400
  },
  "claim-preview-bad-token": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 400
  },
  "login": {
    "content_type": "application/json",
    "set_cookie": "sid=*; httponly; max-age=1209600; path=/; samesite=lax",
    "shape": {
      "user": {
        "created_at": "string",
        "disabled": "bool",
        "id": "number",
        "is_admin": "bool",
        "model_tier": "string",
        "username": "string"
      }
    },
    "status": 200
  },
  "login-malformed": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 422
  },
  "login-throttled": {
    "content_type": "application/json",
    "retry-after": "*",
    "shape": {
      "detail": "string"
    },
    "status": 429
  },
  "login-unknown-user": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 401
  },
  "logout": {
    "content_type": "application/json",
    "set_cookie": "sid=*; expires=*; max-age=0; path=/; samesite=lax",
    "shape": {
      "authenticated": "bool"
    },
    "status": 200
  },
  "me": {
    "content_type": "application/json",
    "shape": {
      "auth_required": "bool",
      "authenticated": "bool",
      "is_admin": "bool",
      "user": {
        "id": "number",
        "is_admin": "bool",
        "username": "string"
      }
    },
    "status": 200
  },
  "me-after-logout": {
    "content_type": "application/json",
    "shape": {
      "auth_required": "bool",
      "authenticated": "bool",
      "is_admin": "bool",
      "user": "null"
    },
    "status": 200
  },
  "reset": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 202
  },
  "reset-malformed": {
    "content_type": "application/json",
    "shape": {
      "detail": "string"
    },
    "status": 422
  }
}
