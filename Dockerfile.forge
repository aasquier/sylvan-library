# The Forge worker image (ADR 35, decision 5). Not the app — see `Dockerfile`
# for that. This machine exists to hold a JVM and ~470MB of somebody else's
# rules engine, wake when a match is asked for, and stop itself when idle;
# `mtglab forge-shim` (go/cmd/mtglab/shim.go) is everything it runs.
#
# **It ran Python until Phase 7 of the Go migration** (2026-08-23), which is
# when `sim/tier3` crossed. The shim is a subcommand of the same `mtglab`
# binary the app image serves, so the two images ship one artefact and a skew
# between them is impossible rather than merely unlikely — and this image
# stopped carrying a Python interpreter, a venv, DuckDB and numpy to run a
# three-endpoint HTTP server.
#
# **This Mac cannot build it** (macOS 12, no container runtime), so CI is
# where this file is proven: the `image` job builds it on every pull request,
# and the deploy job pushes it to Fly's private registry and points the
# `forge-worker` machine at it. A red build is the first real feedback.
#
# Three stages: fetch (download and verify Forge), builder (the Go binary),
# runtime (JRE + both of the above, non-root).

# -------------------------------------------------------------------- fetch

FROM debian:trixie-slim AS fetch

# The 2.0.14 release, pinned by the SHA-256 GitHub publishes for the asset.
# Despite the name it *is* the distribution — forge.sh, the desktop jar and
# res/ (docs/FORGE.md says so, established by unpacking it). Executable code
# is pinned by digest, and the digest is checked before a single byte is
# unpacked — the same house rule the OCR shelf's WebAssembly follows.
ARG FORGE_URL="https://github.com/Card-Forge/forge/releases/download/forge-2.0.14/forge-installer-2.0.14.tar.bz2"
ARG FORGE_SHA256="e71749376945177d603d52a21a089bc1574330cf34599544b6bae1a04c83da41"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl bzip2 \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/forge.tar.bz2 "$FORGE_URL" \
 && echo "$FORGE_SHA256  /tmp/forge.tar.bz2" | sha256sum -c - \
 && mkdir -p /opt/forge \
 && tar xjf /tmp/forge.tar.bz2 -C /opt/forge \
 && rm /tmp/forge.tar.bz2

# **Pruned to what a simulation touches**, which is about a quarter of what
# the release ships. The distribution is one download for every way Forge can
# be played — an Adventure RPG, quest mode, a mobile build, a particle
# editor, card names in nine languages — and this machine plays exactly one
# of them: `sim`, from the desktop jar, in English. 465MB arrives; ~110MB is
# reachable from a Commander match.
#
# **Measured rather than assumed** (2026-08-24), the way the other five facts
# about Forge were: a copy holding only the kept paths played the recorded
# Arahbo-vs-Goreclaw game at seed 12345 to the same Turn 9, the same winner
# and the same 8.1s, with nothing on the stream but the result.
#
# What this buys is registry storage, the push in CI, and the first pull onto
# a new host — **not** cold-start latency, which is ~8s of JVM boot and card
# database load either way and is untouched by any of this. Worth doing, not
# worth overselling.
#
# Two things kept that look prunable, both deliberate. `res/skins` and
# `res/sound` are GUI furniture no simulation renders, but `forge.view.Main`
# initialises AWT before any game starts — the fifth fact in docs/FORGE.md,
# and the reason this image carries a full JRE and an X server at all. The
# GUI's own resources are left alone rather than trimmed against a headless
# mode we do not get to use. `res/deckgendecks` is the pass that had to be
# redone: 10MB of matrix data nothing here generates a deck from, whose
# absence still printed `Error reading matrix data` and a caught
# NullPointerException at every boot. A rules engine that throws on startup is
# not a place to save ten megabytes.
#
# Globbed rather than versioned, so bumping `FORGE_URL` above does not
# silently stop pruning the jars.
RUN cd /opt/forge \
 && rm -rf res/adventure res/quest res/conquest res/music docs \
 && rm -f res/languages/cardnames-*.txt \
 && rm -f forge-gui-mobile-dev-*.jar adventure-editor-*.jar \
          gdx-particle-editor.jar \
 && rm -f ./*.exe ./*.cmd \
 && echo "pruned distribution: $(du -sh /opt/forge | cut -f1)"

# `forge.profile.properties` baked at build (ADR 35): Forge reads this file
# from its own program directory and nowhere else, and it is what points the
# engine's user data at a directory this image owns rather than at the
# invoking user's home. The content must match what `run.ensure_profile`
# would write for these paths, so the runtime check finds it current and
# never needs to write into the install.
RUN printf 'userDir=/opt/forge-profile\ncacheDir=/opt/forge-profile/cache\ncardPicsDir=/opt/forge-profile/cache/pics\n' \
      > /opt/forge/forge.profile.properties \
 && mkdir -p /opt/forge-profile/decks/commander /opt/forge-profile/cache

# ------------------------------------------------------------------- scribe

# The scribe (ADR 42): a listener on Forge's game event bus, compiled against
# the very jar this image ships.
#
# **Its own stage, because the runtime has a JRE and no compiler** — and a JDK
# is a few hundred megabytes nobody should carry around to play Magic. What
# ships is the class files, which are a couple of hundred kilobytes.
#
# **Compiled here rather than committed, and against *this* Forge rather than
# any Forge.** That is the point: a `FORGE_URL` bump that changed an event's
# shape becomes a failed build instead of a listener that quietly stops
# hearing something. It is also the only gate this code has in CI, since the
# parity test needs a JVM and minutes of wall clock and therefore cannot run
# there.
#
# Only the jar is copied in, not the whole 470MB distribution: this stage
# needs something to compile against and nothing to play with.
#
# GPL-3.0, and the licence boundary is a process boundary — nothing Go links
# these classes, the shim runs them as a subprocess. See scribe/README.md.
FROM debian:trixie-slim AS scribe

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jdk-headless \
 && rm -rf /var/lib/apt/lists/*

COPY --from=fetch /opt/forge/forge-gui-desktop-*.jar /jars/
COPY scribe/src /scribe/src

RUN set -eu \
 && jar="$(ls /jars/forge-gui-desktop-*.jar)" \
 && javac -Xlint:all -cp "$jar" -d /scribe/out /scribe/src/scribe/*.java \
 && echo "scribe: built against $jar"

# ------------------------------------------------------------------ builder

FROM golang:1.26-trixie AS builder

WORKDIR /build

# Modules first, so the download layer caches across source edits.
COPY go/go.mod go/go.sum ./
RUN go mod download

COPY go ./

# **CGO on, and this is the one place that decision costs something here.**
# The shim itself wants no C library at all — it reads a zip, parses YAML,
# runs a subprocess and speaks JSON — so a static binary was the obvious
# build. It is not available: `mtglab forge-shim` is a subcommand of the
# binary that also serves the front door, and the door reads the card pool
# through DuckDB's prebuilt static archive. `CGO_ENABLED=0 go build
# ./cmd/mtglab` fails at `internal/pool` with "build constraints exclude all
# Go files", measured rather than assumed.
#
# That is a price worth paying rather than a problem to route around. Two
# binaries would be two artefacts to keep in step across a deploy that
# updates the app and the worker minutes apart — and version skew across that
# gap is precisely what `wire.go` is written to survive. One binary makes the
# skew impossible instead of merely handled.
#
# The consequence is a runtime stage that needs glibc and libstdc++ rather
# than nothing, which the JRE below brings anyway and the apt line names
# explicitly so it is a declared dependency and not an inherited one.
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" -o /out/mtglab ./cmd/mtglab

# ------------------------------------------------------------------ runtime

FROM debian:trixie-slim AS runtime

LABEL org.opencontainers.image.title="sylvan-library-forge-worker" \
      org.opencontainers.image.description="Forge match worker (ADR 35)" \
      org.opencontainers.image.source="https://github.com/aasquier/sylvan-library" \
      org.opencontainers.image.licenses="MIT"

# Take Debian's security updates, for the reason the app Dockerfile gives at
# length: the base only rebuilds when Docker Hub feels like it.
#
# The JRE is the **full** one and the image carries an X server, and that is
# the fifth fact about Forge established by running it rather than reading
# about it (docs/FORGE.md has the other four): `sim -q` opens no window, but
# `forge.view.Main` still initialises AWT — fonts, toolkit — before the
# simulation starts. On the first live worker this died as a
# `HeadlessException` swallowed whole by Forge's own crash reporter: exit 1,
# zero bytes of output, diagnosed only by `-verbose:class` showing that
# exception as the last class loaded. The headless JRE package cannot fix
# that (it has no X toolkit at all, which *forces* headless mode), so:
# `openjdk-21-jre` for a real AWT, `xvfb`+`xauth` for a display that renders
# nowhere, and `fontconfig`+`fonts-dejavu-core` so font init finds something
# to load. ~200MB over the headless build, on an image that already carries
# half a gigabyte of card scripts.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      openjdk-21-jre xvfb xauth fontconfig fonts-dejavu-core \
      libstdc++6 \
 && rm -rf /var/lib/apt/lists/*

# The JVM the bridge runs is this wrapper: `run.java_binary` honours
# `MTGLAB_JAVA` first, and `xvfb-run -a` gives every invocation its own
# throwaway display. The version probe pays a spare Xvfb start; a match pays
# nothing it wasn't already paying.
RUN printf '#!/bin/sh\nexec xvfb-run -a java "$@"\n' > /usr/local/bin/forge-java \
 && chmod +x /usr/local/bin/forge-java
ENV MTGLAB_JAVA=/usr/local/bin/forge-java

# The same fixed uid as the app image, for the same reason: predictability
# over accident. `--chown` on the copies below is what makes 470MB of Forge
# arrive owned correctly without a layer-doubling `chown -R` afterwards. The
# profile directory must be writable — every match writes `.dck` files and
# Forge writes its cache there — and the install itself is owned too, because
# Forge runs with it as the working directory and a rules engine that cannot
# write a log where it stands fails in ways nobody should have to debug.
RUN useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin mtglab

COPY --from=builder /out/mtglab /usr/local/bin/mtglab
COPY --from=fetch --chown=10001:10001 /opt/forge /opt/forge
COPY --from=fetch --chown=10001:10001 /opt/forge-profile /opt/forge-profile
# The scribe's classes ride along at a fixed path, and **no environment
# variable points at them yet** — nothing reads one. `configrecord_test.go`
# holds `.env.example` equal to the names shipping code actually reads, in
# both directions, and a variable declared here for a reader that does not
# exist is the exact drift that gate was written for. The wiring adds the
# name to both files at once, or to neither.
COPY --from=scribe --chown=10001:10001 /scribe/out /opt/scribe

ENV MTGLAB_FORGE_HOME=/opt/forge \
    MTGLAB_FORGE_PROFILE=/opt/forge-profile

USER mtglab
WORKDIR /opt/forge

EXPOSE 8080

# The shim serves until it has been idle long enough, then exits 0 — with the
# machine's `restart: no` policy that is how "stopped when idle" actually
# happens, because Fly's proxy-driven auto-stop never sees private-network
# traffic. See `go/cmd/mtglab/shim.go`.
CMD ["mtglab", "forge-shim"]
